# Flask 应用配置
PORT=5000
DEBUG=False
FRONTEND_URL=*
PUBLISH_PASSWORD=your_publish_password

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# NVIDIA 多模态 API 配置（图片 OCR / 多模态排版）
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=stepfun-ai/step-3.7-flash

# GitHub 配置
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username
GITHUB_REPO=your_github_repo_name

# QStash 异步任务配置（可选，不配置则回退同步发布）
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# Upstash Redis 配置（可选，用于持久化任务历史）
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Webhook 基础地址（QStash 回调地址，部署后必填，如 https://your-api.example.com）
WEBHOOK_BASE_URL=https://your-api.example.com

# apihz.cn 第三方解析 API 凭证（小红书/今日头条解析用，必填，否则解析会失败）
APIHZ_DEVELOPER_ID=your_apihz_developer_id
APIHZ_API_KEY=your_apihz_api_key

# Vercel 配置（仅在 Vercel 上使用）
PYTHON_VERSION=3.9
